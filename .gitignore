# SEER data and anything that could expose individual-level information.
# The SEER Research Data Use Agreement forbids releasing the data or publishing
# information generated by a case listing session, and requires counts of 1 to 4
# to be suppressed in publications.
data/
*.slm
*.slf

# Internal outputs: full label frequencies from the case listing and unsuppressed tables.
reports/phase0.md
reports/phase0_tables/
reports/phase3_tables/

reports/phase4_tables/descriptive_*
reports/phase4_tables/models_stdout.txt
reports/phase4_tables/equity_selection_stdout.txt
# Exact group counts (can include 1 to 4 men); published reports show rounded, suppressed versions
reports/phase4_tables/selection_bounds_*.csv
reports/phase4_tables/selection_ipw.csv
reports/phase4_tables/excess_days_crude.csv
reports/phase4_tables/equity_concentration_curves.csv
reports/phase4_tables/sensitivity_delay_summary.csv
reports/phase4_tables/receipt_crude_*.csv
reports/phase4_tables/revision_long_intervals.csv
reports/phase4_tables/revision_income_by_period.csv
reports/phase4_tables/*_stdout.txt

# Development runs on subsamples (scripts --sample)
reports/**/*_sample*

# Environment and caches
.venv/
__pycache__/
.pytest_cache/
.DS_Store

# LaTeX build intermediates and check output from scripts/build_paper.py
paper/tex/build/
paper/number_audit.txt

# Kept locally, not published: working notes, review records, run logs, raw search dumps,
# PNG copies of figures and the superseded matplotlib flow chart (the paper draws it in TikZ)
PROGRESS.md
QUICK_VIEW.md
paper/review/
paper/figures/*.png
paper/figures/figure1_flow.*
reports/phase4_tables/*_log.txt
reports/phase1_search/articles.json
reports/phase1_search/similar_articles.json
